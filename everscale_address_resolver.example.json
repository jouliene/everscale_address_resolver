{
  "base_url": "https://validatorsclock.xyz",
  "interval_secs": 60,
  "full_geo_refresh_secs": 3600,
  "state": "out/runtime/everscale_nodes_state.json",
  "output": "out/everscale_map/everscale_full.json",
  "map_output": "out/everscale_map/everscale_nodes.json",
  "map_cache": "out/runtime/everscale_map_cache.json",
  "map_stale_after_secs": 3600,
  "compact": true,
  "resolver": {
    "global_config_path": "/home/admin/everscale_dht_bootstrap/everscale-bootstrap-global-config.json",
    "lookup_timeout_secs": 30,
    "workers": 16
  },
  "geo": {
    "endpoint": "http://ip-api.com/batch?fields=status,message,country,countryCode,regionName,city,lat,lon,isp,org,as,query",
    "batch_size": 100,
    "cache": "out/runtime/everscale_geo_cache.json"
  }
}
